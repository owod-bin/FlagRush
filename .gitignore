# ============================================================
# 二进制 / 大文件 —— 不进仓库（走 Release 分发）
# 注意：.gitignore 不支持行尾注释，注释必须单独占一行
# ============================================================
/runtime/
# tools/ 里放二进制（tesseract 便携版等），不进 git；
# 但工具脚本（校验、打包后清理、推送）要进，方便复现
/tools/*
!/tools/*.py
/dist/
/build/
*.exe
*.dll
*.pyd
*.so

# ============================================================
# 运行时产物 / 用户数据
# ============================================================
/uploads/
/工作区/
_carved/
__pycache__/
*.py[cod]
*.pyo
*.log
.pytest_cache/
.coverage
htmlcov/

# 本地设置与个人配置
界面设置.json
/flag格式.txt

# ============================================================
# 编辑器 / 系统
# ============================================================
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini

# ============================================================
# 测试临时文件
# 统一规则：以 _ 开头的都是临时产物（调试脚本 / 样本 / 日志 / 目录）。
# 不会误伤 app.ico / app_icon_512.png / 使用说明.md 这些正式文件
# （它们不以 _ 开头）。
# ============================================================
/_*/
/_*.*
/core/_*
/core/_*/
_corpus_*.txt
_dl_*.txt
_tree.json
_cm.txt
_msg.txt
_v.py
_c_*.py

# 分析过程产生的临时目录（生成在被分析文件旁边时也要忽略）
_split/
_位平面/
_dct_out/
_bits_out/
_tess*/

# 打包时的临时输出目录
dist_build/
