# ============================================================
# 二进制 / 大文件 —— 不进仓库（走 Release 分发）
# 注意：.gitignore 不支持行尾注释，注释必须单独占一行
# ============================================================
/runtime/
# tools/ 里放二进制（tesseract 便携版等），不进 git；
# 但工具脚本（校验、打包后清理、推送）要进，方便复现
/tools/*
!/tools/*.py
/dist/
/build/
*.exe
*.dll
*.pyd
*.so

# ============================================================
# 运行时产物 / 用户数据
# ============================================================
/uploads/
/工作区/
_carved/
__pycache__/
*.py[cod]
*.pyo
*.log
.pytest_cache/
.coverage
htmlcov/

# 本地设置与个人配置
界面设置.json
/flag格式.txt

# ============================================================
# 编辑器 / 系统
# ============================================================
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini

# ============================================================
# 测试临时文件
# ============================================================
/_smoke/
/_stegotest/
/_real/
/_tree.json
_corpus_*.txt
_dl_*.txt

# 临时调试脚本
/_*.py

# 分析过程产生的临时目录
_split/
_位平面/
_dct_out/
_bits_out/

# 打包时的临时目录（tesseract 精简过程产生）
_tess*/

# 打包时的临时目录（tesseract 精简过程产生）
_tess*/

# 提交信息临时文件
_cm.txt
_msg.txt
